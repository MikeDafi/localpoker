{
  "rules": {
    "localpoker": {
      "rooms": {
        "$code": {
          /*
           * A room still in the lobby is readable by anyone signed in.
           *
           * Anyone holding the code is already permitted to seat themselves
           * under players/$uid, so withholding the read granted no privacy and
           * only made joining impossible: joinRoom confirms the room exists
           * before writing, and that read was denied for precisely the people
           * who needed it. The symptom was a joiner told either "permission
           * denied" or "room does not exist" for a room that plainly existed.
           *
           * Once status leaves 'lobby' the room narrows back to its host and
           * seated players, so nobody can watch a game they never joined.
           */
          ".read": "auth != null && (!data.exists() || data.child('status').val() === 'lobby' || data.child('hostId').val() === auth.uid || data.child('players').child(auth.uid).exists())",
          /*
           * The last clause lets anyone delete a table nobody came back to.
           *
           * A host losing its connection marks hostAwayAt first, so a dropped
           * phone does not end a game instantly. Clients close their own view
           * after the connection grace period, but the database row still has
           * no server process to tidy it up. So whoever next trips over the
           * corpse may bury it, but only once it is provably cold: deletion
           * only, and only ten minutes after the marker was set.
           */
          ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || (data.exists() && data.child('hostId').val() === auth.uid) || (data.exists() && data.child('status').val() === 'ended' && data.child('endedAt').isNumber() && data.child('endedAt').val() < now - 86400000 && newData.child('hostId').val() === auth.uid) || (!newData.exists() && data.exists() && ((data.child('hostAwayAt').isNumber() && data.child('hostAwayAt').val() < now - 600000) || (data.child('endedAt').isNumber() && data.child('endedAt').val() < now - 600000))))",
          ".validate": "newData.hasChildren(['code','hostId']) || !newData.exists()",
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "hostId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "settingsJson": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          },
          "tournamentStartedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "actionSeq": {
            ".write": "auth != null && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists() && newData.isNumber() && newData.val() > data.val() && newData.val() <= data.val() + 100",
            ".validate": "newData.isNumber()"
          },
          "endedReason": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "hostAwayAt": {
            ".validate": "newData.isNumber()"
          },
          "endedAt": {
            ".validate": "newData.isNumber()"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.parent().parent().child('hostId').val() === auth.uid || (data.exists() && root.child('localpoker').child('rooms').child($code).child('status').val() !== 'ended' && newData.child('id').val() === data.child('id').val() && newData.child('isHost').val() === data.child('isHost').val() && newData.child('seatIndex').val() === data.child('seatIndex').val() && newData.child('chips').val() === data.child('chips').val()) || (!data.exists() && root.child('localpoker').child('rooms').child($code).child('status').val() === 'lobby' && !root.child('localpoker').child('blocks').child(newData.parent().parent().child('hostId').val()).child(auth.uid).exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['id','name']) && newData.child('id').val() === auth.uid && newData.child('isHost').val() === (newData.parent().parent().child('hostId').val() === auth.uid))",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 24 && !(newData.val().matches(/.*[Ff][Uu][Cc][Kk].*/) || newData.val().matches(/.*[Ss][Hh][Ii][Tt].*/) || newData.val().matches(/.*[Cc][Uu][Nn][Tt].*/) || newData.val().matches(/.*[Nn][Aa][Zz][Ii].*/) || newData.val().matches(/.*[Hh][Ii][Tt][Ll][Ee][Rr].*/) || newData.val().matches(/.*[Nn][Ii][Gg][Gg][Ee][Rr].*/) || newData.val().matches(/.*[Ff][Aa][Gg][Gg][Oo][Tt].*/))"
              },
              "chips": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
              },
              "seatIndex": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
              },
              "connected": {
                ".validate": "newData.isBoolean()"
              },
              "isHost": {
                ".validate": "newData.isBoolean()"
              },
              "palJson": {
                ".validate": "newData.isString() && newData.val().length <= 600"
              },
              "palSeed": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "id": {
                ".validate": "newData.isString() && newData.val() === auth.uid"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "publicState": {
            ".write": "auth != null && root.child('localpoker').child('rooms').child($code).child('hostId').val() === auth.uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['version','config','players','playerOrder','street','handNumber','contributions','currentPlayerIndex','dealerIndex','currentBet','minRaise']) && newData.child('version').val() === 1 && !newData.child('deck').exists() && !newData.child('seed').exists())",
            "version": {
              ".validate": "newData.isNumber() && newData.val() === 1"
            },
            "street": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "handNumber": {
              ".validate": "newData.isNumber()"
            },
            "currentPlayerIndex": {
              ".validate": "newData.isNumber()"
            },
            "currentPlayerId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "dealerIndex": {
              ".validate": "newData.isNumber()"
            },
            "dealerId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "currentBet": {
              ".validate": "newData.isNumber()"
            },
            "minRaise": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "config": {
              ".validate": "newData.hasChildren(['smallBlind','bigBlind','startingStack','maxPlayers','turnTimerSec'])",
              "$key": {
                ".validate": "newData.isNumber()"
              }
            },
            "board": {
              "$i": {
                ".validate": "$i.matches(/^[0-4]$/) && newData.hasChildren(['rank','suit'])",
                "rank": {
                  ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 14"
                },
                "suit": {
                  ".validate": "newData.isString() && (newData.val() === 'c' || newData.val() === 'd' || newData.val() === 'h' || newData.val() === 's')"
                }
              }
            },
            "players": {
              "$uid": {
                ".validate": "newData.hasChildren(['id','name','seatIndex','chips','folded','allIn','currentBet','hasActed','sittingOut','holeCardCount']) && newData.child('id').val() === $uid && !newData.child('deck').exists()",
                "id": {
                  ".validate": "newData.isString() && newData.val().length <= 128"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length <= 24 && !(newData.val().matches(/.*[Ff][Uu][Cc][Kk].*/) || newData.val().matches(/.*[Ss][Hh][Ii][Tt].*/) || newData.val().matches(/.*[Cc][Uu][Nn][Tt].*/) || newData.val().matches(/.*[Nn][Aa][Zz][Ii].*/) || newData.val().matches(/.*[Hh][Ii][Tt][Ll][Ee][Rr].*/) || newData.val().matches(/.*[Nn][Ii][Gg][Gg][Ee][Rr].*/) || newData.val().matches(/.*[Ff][Aa][Gg][Gg][Oo][Tt].*/))"
                },
                "seatIndex": {
                  ".validate": "newData.isNumber()"
                },
                "chips": {
                  ".validate": "newData.isNumber()"
                },
                "folded": {
                  ".validate": "newData.isBoolean()"
                },
                "allIn": {
                  ".validate": "newData.isBoolean()"
                },
                "currentBet": {
                  ".validate": "newData.isNumber()"
                },
                "hasActed": {
                  ".validate": "newData.isBoolean()"
                },
                "isBot": {
                  ".validate": "newData.isBoolean()"
                },
                "sittingOut": {
                  ".validate": "newData.isBoolean()"
                },
                "connected": {
                  ".validate": "newData.isBoolean()"
                },
                "isHost": {
                  ".validate": "newData.isBoolean()"
                },
                "palSeed": {
                  ".validate": "newData.isString() && newData.val().length <= 128"
                },
                "holeCardCount": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
                },
                "holeCards": {
                  ".validate": "newData.hasChildren(['0','1'])",
                  "$i": {
                    ".validate": "$i.matches(/^[01]$/) && newData.hasChildren(['rank','suit'])",
                    "rank": {
                      ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 14"
                    },
                    "suit": {
                      ".validate": "newData.isString() && (newData.val() === 'c' || newData.val() === 'd' || newData.val() === 'h' || newData.val() === 's')"
                    }
                  }
                },
                "exposedHoleCards": {
                  "$i": {
                    ".validate": "$i.matches(/^[01]$/) && newData.hasChildren(['rank','suit'])",
                    "rank": {
                      ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 14"
                    },
                    "suit": {
                      ".validate": "newData.isString() && (newData.val() === 'c' || newData.val() === 'd' || newData.val() === 'h' || newData.val() === 's')"
                    }
                  }
                }
              }
            }
          },
          /*
           * Reactions. One node per sender, overwritten rather than appended,
           * so the table cannot be used as an unbounded message log. The value
           * is length-capped because it carries a Giphy id for GIF reactions
           * and nothing here should become a place to stash arbitrary text.
           */
          /*
           * Who this table advertised itself to, so the host can withdraw
           * those invites when the game starts or the room ends. Booleans
           * only: it is a set of uids, not somewhere to attach data.
           */
          "invited": {
            "$friendUid": { ".validate": "newData.isBoolean()" }
          },
          /*
           * Players who chose to table their hand.
           *
           * Showing a bluff after everyone folded is a deliberate act, and it
           * only means anything if the other players see it. Written by the
           * owner alone, so nobody can expose somebody else's cards, and the
           * host clears the node when the next hand is dealt.
           */
          "shown": {
            "$playerId": {
              ".write": "auth != null && ((auth.uid === $playerId && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists()) || (root.child('localpoker').child('rooms').child($code).child('hostId').val() === auth.uid && !newData.exists()))",
              ".validate": "!newData.exists() || newData.isBoolean()"
            }
          },
          /*
           * Players who exposed one card before the showdown.
           *
           * This is not the same as tabling a hand. The owner can only add a
           * true flag for their own left or right card, never remove it and
           * never choose for another seat. The host clears the set when the
           * next hand is published.
           */
          "exposed": {
            "$playerId": {
              ".write": "auth != null && root.child('localpoker').child('rooms').child($code).child('hostId').val() === auth.uid && !newData.exists()",
              ".validate": "!newData.exists() || newData.hasChildren(['0']) || newData.hasChildren(['1'])",
              "0": {
                ".write": "auth != null && auth.uid === $playerId && newData.exists() && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists()",
                ".validate": "newData.isBoolean() && newData.val() === true"
              },
              "1": {
                ".write": "auth != null && auth.uid === $playerId && newData.exists() && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists()",
                ".validate": "newData.isBoolean() && newData.val() === true"
              },
              "$other": { ".validate": false }
            }
          },
          /*
           * Consent to leave the finished hand.
           *
           * The hand number is stored with the flag because the host clears
           * this node as a normal client write, not a server transaction. If a
           * clear is delayed or lost, an old answer must not count for the next
           * hand and make the table run on its own.
           */
          "handReady": {
            "$playerId": {
              ".write": "auth != null && ((auth.uid === $playerId && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists()) || (root.child('localpoker').child('rooms').child($code).child('hostId').val() === auth.uid && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['handNumber','ts']) && newData.child('handNumber').isNumber() && newData.child('handNumber').val() >= 0 && newData.child('ts').isNumber())",
              "handNumber": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          /*
           * Rebuy requests. One node per seat, written by that player and
           * cleared by the host after handling. It carries no amount, because
           * the host must derive the stack from the table config.
           */
          "rebuys": {
            "$playerId": {
              ".write": "auth != null && ((auth.uid === $playerId && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists()) || (root.child('localpoker').child('rooms').child($code).child('hostId').val() === auth.uid && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['playerId','ts']) && newData.child('playerId').val() === auth.uid && newData.child('ts').isNumber())",
              "playerId": { ".validate": "newData.isString() && newData.val() === $playerId" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "runVotes": {
            "$playerId": {
              ".write": "auth != null && ((auth.uid === $playerId && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists()) || (root.child('localpoker').child('rooms').child($code).child('hostId').val() === auth.uid && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['choice','ts']) && newData.child('choice').isNumber() && newData.child('choice').val() >= 1 && newData.child('choice').val() <= 4 && newData.child('ts').isNumber())",
              "choice": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "emotes": {
            "$playerId": {
              ".write": "auth != null && auth.uid === $playerId && root.child('localpoker').child('rooms').child($code).child('players').child(auth.uid).exists()",
              ".validate": "!newData.exists() || (newData.hasChildren(['type','value','ts']) && newData.child('type').isString() && (newData.child('type').val() === 'emoji' || newData.child('type').val() === 'text' || newData.child('type').val() === 'sticker' || newData.child('type').val() === 'gif' || newData.child('type').val() === 'palMotion') && newData.child('value').isString() && newData.child('value').val().length <= 64 && newData.child('ts').isNumber() && (!newData.child('anim').exists() || (newData.child('anim').isString() && newData.child('anim').val().length <= 12)))",
              /*
               * Each field needs its own rule, not just a mention in the
               * validate string above. "$other": false rejects every named
               * child that is not separately declared, which silently refused
               * perfectly valid reactions until each of these existed.
               */
              "type": { ".validate": "newData.isString()" },
              "value": { ".validate": "newData.isString() && newData.val().length <= 64" },
              "anim": { ".validate": "newData.isString() && newData.val().length <= 12" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "actions": {
            "$id": {
              ".write": "auth != null && newData.child('playerId').val() === auth.uid",
              ".validate": "newData.hasChildren(['playerId','type','seq','ts']) && newData.child('playerId').val() === auth.uid && newData.child('type').isString() && (newData.child('type').val() === 'fold' || newData.child('type').val() === 'check' || newData.child('type').val() === 'call' || newData.child('type').val() === 'bet' || newData.child('type').val() === 'raise' || newData.child('type').val() === 'allin') && newData.child('seq').isNumber() && root.child('localpoker').child('rooms').child($code).child('actionSeq').isNumber() && newData.child('seq').val() > root.child('localpoker').child('rooms').child($code).child('actionSeq').val() && newData.child('seq').val() <= 9007199254740990 && newData.child('ts').isNumber() && (!newData.child('amount').exists() || newData.child('amount').isNumber())"
            }
          }
        }
      },
      "views": {
        "$code": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((root.child('localpoker').child('rooms').child($code).child('hostId').val() === auth.uid && root.child('localpoker').child('rooms').child($code).child('players').child($uid).exists()) || (auth.uid === $uid && !newData.exists()))",
            ".validate": "!newData.exists() || (newData.hasChildren(['version','playerId','handNumber','holeCards']) && newData.child('version').val() === 1 && newData.child('playerId').val() === $uid && !newData.child('deck').exists() && !newData.child('seed').exists())",
            "version": {
              ".validate": "newData.isNumber() && newData.val() === 1"
            },
            "code": {
              ".validate": "newData.isString() && newData.val() === $code"
            },
            "playerId": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "handNumber": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "holeCards": {
              ".validate": "newData.hasChildren(['0','1'])",
              "$i": {
                ".validate": "$i.matches(/^[01]$/) && newData.hasChildren(['rank','suit'])",
                "rank": {
                  ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 14"
                },
                "suit": {
                  ".validate": "newData.isString() && (newData.val() === 'c' || newData.val() === 'd' || newData.val() === 'h' || newData.val() === 's')"
                }
              }
            }
          }
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['handle','displayName','updatedAt']) && newData.child('handle').isString() && newData.child('handle').val().matches(/^[a-z0-9_]{3,20}$/) && !newData.child('handle').val().matches(/.*(fuck|shit|cunt|nazi|hitler|nigger|faggot).*/) && root.child('localpoker').child('handles').child(newData.child('handle').val()).val() === $uid && newData.child('displayName').isString() && newData.child('displayName').val().length >= 1 && newData.child('displayName').val().length <= 24 && !(newData.child('displayName').val().matches(/.*[Ff][Uu][Cc][Kk].*/) || newData.child('displayName').val().matches(/.*[Ss][Hh][Ii][Tt].*/) || newData.child('displayName').val().matches(/.*[Cc][Uu][Nn][Tt].*/) || newData.child('displayName').val().matches(/.*[Nn][Aa][Zz][Ii].*/) || newData.child('displayName').val().matches(/.*[Hh][Ii][Tt][Ll][Ee][Rr].*/) || newData.child('displayName').val().matches(/.*[Nn][Ii][Gg][Gg][Ee][Rr].*/) || newData.child('displayName').val().matches(/.*[Ff][Aa][Gg][Gg][Oo][Tt].*/)) && newData.child('updatedAt').isNumber() && (!newData.child('palJson').exists() || (newData.child('palJson').isString() && newData.child('palJson').val().length <= 600)))"
        }
      },
      "pushTokens": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('localpoker').child('friends').child($uid).child(auth.uid).exists() || root.child('localpoker').child('friendRequests').child($uid).child(auth.uid).child('status').val() === 'pending')",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['token','updatedAt'])",
          "token": { ".validate": "newData.isString() && newData.val().length <= 200 && (newData.val().beginsWith('ExponentPushToken[') || newData.val().beginsWith('ExpoPushToken['))" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "presence": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['online','lastSeen'])",
          "online": { ".validate": "newData.isBoolean()" },
          "lastSeen": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "handles": {
        ".read": "auth != null && query.orderByKey === true && query.limitToFirst <= 10 && query.startAt !== null && query.endAt !== null",
        "$handle": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.isString() && newData.val() === auth.uid && $handle.matches(/^[a-z0-9_]{3,20}$/) && !$handle.matches(/.*(fuck|shit|cunt|nazi|hitler|nigger|faggot).*/)) || (data.exists() && data.val() === auth.uid && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid)"
        }
      },
      "friendRequests": {
        "$toUid": {
          ".read": "auth != null && auth.uid === $toUid",
          ".write": "auth != null && auth.uid === $toUid && !newData.exists()",
          "$fromUid": {
