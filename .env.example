# Copy this file to .env and fill in these values to enable online Firebase play.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Google sign-in. Firebase Console > Authentication > Sign-in method > Google
# creates both clients for you; copy them from Project settings > Your apps.
# These are public OAuth client identifiers, not secrets: they ship inside the
# app binary. Leave them blank to hide the Google button and keep Guest only.
# Google sign-in never works in Expo Go, because the OAuth redirect is bound to
# this app's bundle identifier rather than Expo Go's. Use a dev or TestFlight
# build to test it.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: enables production error reporting when running a native/EAS build.
# Leave blank in local dev and Expo Go; telemetry safely no-ops without it.
EXPO_PUBLIC_SENTRY_DSN=

# Note: GIF reactions need no key: the app ships a curated pack served straight
# from Giphy's public media CDN (see src/services/gifs.ts).
