# Copy this file to .env and fill in these values to enable online Firebase play.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional: enables production error reporting when running a native/EAS build.
# Leave blank in local dev and Expo Go; telemetry safely no-ops without it.
EXPO_PUBLIC_SENTRY_DSN=

# Note: GIF reactions need no key — the app ships a curated pack served straight
# from Giphy's public media CDN (see src/services/gifs.ts).
