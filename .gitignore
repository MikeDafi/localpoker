# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local bundle export
.bundle-check/

# local env (Firebase keys)
.env

# Short-lived gcloud access token used for Firebase admin calls — never commit
.tok

# Throwaway python env for scripts/measure-ref-card.py (see its docstring)
.venv-tools/

# Python bytecode cache from the scripts/ helpers
__pycache__/

# Xcode build output from the XCUITest harness. The harness source itself
# (.maestro/xctest) is checked in; DerivedData is 150MB+ of build artifacts.
.maestro/DerivedData/

# Firebase emulator output from `npm run test:rules`
database-debug.log
firebase-debug.log
ui-debug.log

# Agent tooling logs and QA run logs. The QA screenshots and JSON captures in
# docs/qa are worth keeping; the raw xctest console dumps are not.
.claude/logs/
docs/qa/*.log

# Built output of the legal site (docs/site/build-legal-site.mjs). CI builds it
# fresh; a local run must never be committed.
_site/

# Xcode test result bundles from QA runs. The screenshots in docs/qa are worth
# keeping; the .xcresult bundles are 200MB of build artifacts.
*.xcresult/

# Screenshots extracted from .xcresult bundles, duplicate build output
docs/qa/xcresult-attachments/
